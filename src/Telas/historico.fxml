<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="457.0" prefWidth="640.0"
            style="-fx-background-color: linear-gradient(#250934, #151217);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controladores.historicoController">
   <children>
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="DODGERBLUE" height="200.0"
                 layoutX="-363.0" layoutY="-132.0" stroke="BLACK" strokeType="INSIDE" width="200.0" />
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#2f3f4b" height="30.0"
                 layoutX="523.0" layoutY="26.0" stroke="BLACK" strokeType="INSIDE" width="99.0" />

      <!-- Cabeçalho -->
      <Text fill="WHITE" layoutX="485.0" layoutY="46.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Saldo:" />
      <Label fx:id="saldo" layoutX="559.0" layoutY="33.0" textFill="WHITE" />
      <Button fx:id="menu" layoutX="32.0" layoutY="29.0" mnemonicParsing="false" onAction="#irpratelaMenu" text="Menu" />
      <Text fill="WHITE" layoutX="283.0" layoutY="32.0" strokeType="OUTSIDE" strokeWidth="0.0"
            text="Histórico" wrappingWidth="89.48779296875">
         <font>
            <Font name="System Bold" size="17.0" />
         </font>
      </Text>

      <!-- Mensagem quando não há histórico -->
      <Label fx:id="mostraHistorico" layoutX="197.0" layoutY="192.0" prefHeight="73.0" prefWidth="247.0"
             text="Você ainda não investiu em nenhuma ação :(" textAlignment="JUSTIFY" textFill="#616161" />

      <!-- Tabela de histórico -->
      <TableView fx:id="historicoTable" layoutX="14.0" layoutY="65.0" prefHeight="375.0" prefWidth="612.0"
                 style="-fx-background-color: #1a1a2e; -fx-border-color: #3a3a5c;">
         <columns>
            <TableColumn fx:id="tipoOperacaoCol" text="Tipo" prefWidth="80.0" />
            <TableColumn fx:id="simboloAcaoCol" text="Ação" prefWidth="100.0" />
            <TableColumn fx:id="quantidadeCol" text="Quantidade" prefWidth="100.0" />
            <TableColumn fx:id="precoPorAcaoCol" text="Preço por Ação" prefWidth="130.0" />
            <TableColumn fx:id="valorTotalCol" text="Valor Total" prefWidth="130.0" />
         </columns>
      </TableView>

   </children>
</AnchorPane>
