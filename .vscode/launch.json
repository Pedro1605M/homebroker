{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run HomeBroker",
            "request": "launch",
            "mainClass": "Main",
            "classPaths": ["${workspaceFolder}/bin", "${workspaceFolder}/lib/*"],
            "vmArgs": "--module-path ${workspaceFolder}/lib --add-modules javafx.controls,javafx.fxml",
            "preLaunchTask": "build"
        }
    ]
}
